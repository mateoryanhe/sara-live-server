# nginx配置示例 - 将/res路径映射到前端构建目录
server {
    listen 80;
    server_name localhost;  # 修改为你的域名或IP

    # 静态资源 - 前端构建结果
    location /res/ {
        alias /path/to/your/dist/;  # 修改为实际的dist目录路径
        try_files $uri $uri/ /res/index.html;  # 支持Vue Router的history模式

        # 带 hash 的 js/css 等可长期缓存；index.html 必须单独禁止缓存
        location ~* \.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        location = /res/index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }
        
        # 防止访问隐藏文件（如.git等）
        location ~ /\. {
            deny all;
        }
    }

    # API请求代理到后端服务
    location /api/ {
        proxy_pass http://127.0.0.1:8898/;  # 修改为实际的后端地址
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 其他API请求（根据实际后端API路径调整）
    location /auth/ {
        proxy_pass http://127.0.0.1:8898/;  # 修改为实际的后端地址
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /account/ {
        proxy_pass http://127.0.0.1:8898/;  # 修改为实际的后端地址
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 错误页面
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root html;
    }
}