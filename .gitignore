# Local Go build output
go-build/*
!go-build/.gitkeep

# Accidental build output (go build -o .../xxx.exe creates literal "..." folder)
go-src/module/logquery/.../

# Hot restart gateway local secrets
pub-tool/live-hot-restart-gw/config.json

# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test / coverage
*.test
*.out

# Flutter client：源码入库；构建/工具缓存忽略（细节见 flutter-client/.gitignore）
flutter-client/build/
flutter-client/.dart_tool/
flutter-client/.idea/
flutter-client/.apk_build/
flutter-client/.tmp-agora-logs/
flutter-client/logs/
flutter-client/**/*.iml
flutter-client/.flutter-plugins
flutter-client/.flutter-plugins-dependencies
flutter-client/android/.gradle/
flutter-client/android/local.properties
flutter-client/android/**/build/
flutter-client/android/.kotlin/
