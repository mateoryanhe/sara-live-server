# Local Go build output
go-build/*
!go-build/.gitkeep

# Accidental build output (go build -o .../xxx.exe creates literal "..." folder)
go-src/module/logquery/.../

# Hot restart gateway local secrets
pub-tool/live-hot-restart-gw/config.json

# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test / coverage
*.test
*.out

# Flutter client（本地开发暂不入库；scripts 可入库）
flutter-client/*
!flutter-client/scripts/
!flutter-client/scripts/**
